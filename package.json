{
  "name": "testing-framework-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright-based E2E testing framework with AI used only as a failure-path exception handler.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "record": "node scripts/record-test.js",
    "manifest:generate": "node scripts/generate-manifest.js",
    "server:dev": "node --watch server/src/index.ts",
    "server:start": "node server/src/index.ts",
    "test:server": "node --test server/test/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
