{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(docker --version)",
      "Bash(git checkout *)",
      "Bash(npm install *)",
      "Bash(npx playwright *)",
      "Bash(npm ls *)",
      "Bash(docker compose *)",
      "Bash(timeout 240 bash -c 'while ps -p 16444 > /dev/null 2>&1; do sleep 5; done')",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  }
}
